; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="rylm"
run/main_scene="uid://bfijroxaium63"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://bac7bcshq5ki8"

[autoload]

Item_Database="*res://Scripts/Autoload/item_database.gd"
Game_State="*res://Scripts/Autoload/GameState.gd"
Input_Manager="*res://Scripts/Autoload/InputManager.gd"
PSXScreenEffects="*uid://u3y0jxl0vtmg"

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="viewport"

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/psx_visuals/plugin.cfg", "res://addons/raytraced_audio/plugin.cfg")

[gui]

theme/autoload_on_startup=false

